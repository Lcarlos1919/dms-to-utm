{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "outDir": ".test-build",
    "rootDir": "lib"
  },
  "include": [
    "lib/topocad/*.ts"
  ]
}
